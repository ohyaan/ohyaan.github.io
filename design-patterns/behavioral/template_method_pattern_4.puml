@startuml
!theme sunlust
abstract class ReportGenerator {
    +generateReport(title): void
    #createHeader(title): void {abstract}
    #addContent(): void {abstract}
    #createFooter(): void {abstract}
    #includeTableOfContents(): bool
    #addTableOfContents(): void
    #includeCharts(): bool
    #addCharts(): void
}

class PDFReport {
    #createHeader(title): void
    #addContent(): void
    #createFooter(): void
    #includeTableOfContents(): bool
    #includeCharts(): bool
}

class HTMLReport {
    #createHeader(title): void
    #addContent(): void
    #createFooter(): void
    #includeCharts(): bool
}

class PlainTextReport {
    #createHeader(title): void
    #addContent(): void
    #createFooter(): void
}

ReportGenerator <|-- PDFReport
ReportGenerator <|-- HTMLReport
ReportGenerator <|-- PlainTextReport
@enduml