@startuml
!theme sunlust
class Document {
    -state: DocumentState
    -content: string
    -author: string
    +publish(): void
    +review(): void
    +approve(): void
    +reject(): void
}

interface DocumentState {
    +publish(Document): void
    +review(Document): void
    +approve(Document): void
    +reject(Document): void
}

class DraftState {
    +publish(): void
}

class ModerationState {
    +review(): void
    +approve(): void
    +reject(): void
}

class PublishedState {
    +reject(): void
}

Document o--> DocumentState
DocumentState <|.. DraftState
DocumentState <|.. ModerationState
DocumentState <|.. PublishedState

DraftState -[#blue]-> ModerationState : publish()
ModerationState -[#green]-> PublishedState : approve()
ModerationState -[#red]-> DraftState : reject()
PublishedState -[#red]-> DraftState : reject()\n(unpublish)

note right of Document
    Workflow states:
    Draft → Moderation → Published
    Can be rejected at any stage
end note
@enduml