@startuml
!theme sunlust
class TCPConnection {
    -state: TCPState
    +setState(TCPState): void
    +open(): void
    +close(): void
    +acknowledge(): void
    +getCurrentState(): string
}

interface TCPState {
    +open(TCPConnection): void
    +close(TCPConnection): void
    +acknowledge(TCPConnection): void
    +getStateName(): string
}

class TCPClosed {
    +open(TCPConnection): void
    +close(TCPConnection): void
    +acknowledge(TCPConnection): void
}

class TCPListen {
    +open(TCPConnection): void
    +close(TCPConnection): void
    +acknowledge(TCPConnection): void
}

class TCPEstablished {
    +open(TCPConnection): void
    +close(TCPConnection): void
    +acknowledge(TCPConnection): void
}

TCPConnection o--> TCPState
TCPState <|.. TCPClosed
TCPState <|.. TCPListen
TCPState <|.. TCPEstablished

TCPClosed -[#blue]-> TCPListen : open()
TCPListen -[#blue]-> TCPEstablished : acknowledge()
TCPListen -[#red]-> TCPClosed : close()
TCPEstablished -[#red]-> TCPClosed : close()

note right of TCPConnection
    Context: Represents a
    network connection
end note
@enduml