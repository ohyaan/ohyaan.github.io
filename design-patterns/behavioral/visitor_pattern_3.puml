@startuml
!theme sunlust
interface FileVisitor {
    +visitFile(File): void
    +visitDirectory(Directory): void
}

interface FileSystemNode {
    +accept(FileVisitor): void
    +getName(): string
}

class SizeCalculatorVisitor {
    -totalSize: size_t
    +visitFile(File): void
    +visitDirectory(Directory): void
    +getTotalSize(): size_t
}

class FileListVisitor {
    -files: vector<string>
    -currentPath: string
    +visitFile(File): void
    +visitDirectory(Directory): void
    +getFiles(): vector<string>
}

class SearchVisitor {
    -pattern: string
    -matches: vector<string>
    -currentPath: string
    +SearchVisitor(pattern: string)
    +visitFile(File): void
    +visitDirectory(Directory): void
    +getMatches(): vector<string>
}

class File {
    -name: string
    -size: size_t
    +accept(FileVisitor): void
    +getName(): string
    +getSize(): size_t
}

class Directory {
    -name: string
    -children: vector<FileSystemNode>
    +add(FileSystemNode): void
    +accept(FileVisitor): void
    +getName(): string
    +getChildren(): vector<FileSystemNode>
}

FileVisitor <|.. SizeCalculatorVisitor
FileVisitor <|.. FileListVisitor
FileVisitor <|.. SearchVisitor
FileSystemNode <|.. File
FileSystemNode <|.. Directory

note right of SearchVisitor
    Visitor can maintain
    state (current path)
    while traversing
end note
@enduml