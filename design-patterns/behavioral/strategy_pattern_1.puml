@startuml
!theme sunlust
interface SortStrategy {
    +sort(vector<int>&): void
    +getName(): string
}

class Sorter {
    -strategy: SortStrategy
    +setStrategy(SortStrategy): void
    +sort(vector<int>&): void
}

class BubbleSort {
    +sort(vector<int>&): void
}

class QuickSort {
    +sort(vector<int>&): void
}

class MergeSort {
    +sort(vector<int>&): void
}

Sorter o--> SortStrategy
SortStrategy <|.. BubbleSort
SortStrategy <|.. QuickSort
SortStrategy <|.. MergeSort

note right of Sorter
    Choose sorting algorithm
    based on data size and
    characteristics
end note
@enduml