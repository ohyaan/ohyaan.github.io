@startuml
!theme sunlust
interface DialogMediator {
    + notify(component: Component, event: string): void
}

class LoginDialog {
    - usernameField: Textbox
    - passwordField: Textbox
    - rememberMe: Checkbox
    - loginButton: Button
    - clearButton: Button
    + notify(component: Component, event: string): void
}

abstract class Component {
    # dialog: DialogMediator
    # name: string
    + setDialog(dialog: DialogMediator): void
}

class Button {
    + click(): void
}

class Textbox {
    - text: string
    + setText(text: string): void
    + getText(): string
    + clear(): void
}

class Checkbox {
    - checked: bool
    + setChecked(checked: bool): void
    + isChecked(): bool
}

DialogMediator <|.. LoginDialog
Component <|-- Button
Component <|-- Textbox
Component <|-- Checkbox
Component -> DialogMediator : notifies
LoginDialog o-> Button
LoginDialog o-> Textbox
LoginDialog o-> Checkbox

note right of LoginDialog
    Coordinates all component
    interactions
    - Enable/disable buttons
    - Validate input
    - Clear all fields
end note
@enduml