@startuml
!theme sunlust
interface State {
    +handle(Context): void
}

class Context {
    -state: State
    +setState(State): void
    +request(): void
}

class ConcreteStateA {
    +handle(Context): void
}

class ConcreteStateB {
    +handle(Context): void
}

State <|.. ConcreteStateA
State <|.. ConcreteStateB
Context o--> State : current state
ConcreteStateA ..> Context : changes state
ConcreteStateB ..> Context : changes state

note right of Context
    Delegates state-specific
    behavior to current state
end note

note bottom of ConcreteStateA
    Implements behavior
    associated with state A
end note
@enduml