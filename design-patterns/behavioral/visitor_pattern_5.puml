@startuml
!theme sunlust
interface ExpressionVisitor {
    +visitNumber(Number): void
    +visitAddition(Addition): void
    +visitMultiplication(Multiplication): void
}

interface Expression {
    +accept(ExpressionVisitor): void
}

class EvaluatorVisitor {
    -result: double
    +visitNumber(Number): void
    +visitAddition(Addition): void
    +visitMultiplication(Multiplication): void
    +getResult(): double
}

class StringVisitor {
    -result: string
    +visitNumber(Number): void
    +visitAddition(Addition): void
    +visitMultiplication(Multiplication): void
    +getResult(): string
}

class Number {
    -value: double
    +accept(ExpressionVisitor): void
    +getValue(): double
}

class Addition {
    -left: Expression
    -right: Expression
    +accept(ExpressionVisitor): void
    +getLeft(), getRight(): Expression
}

class Multiplication {
    -left: Expression
    -right: Expression
    +accept(ExpressionVisitor): void
    +getLeft(), getRight(): Expression
}

ExpressionVisitor <|.. EvaluatorVisitor
ExpressionVisitor <|.. StringVisitor
Expression <|.. Number
Expression <|.. Addition
Expression <|.. Multiplication

note right of EvaluatorVisitor
    Visitor recursively
    evaluates sub-expressions
end note
@enduml