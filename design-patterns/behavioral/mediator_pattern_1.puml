@startuml
!theme sunlust
interface ChatRoomMediator {
    + sendMessage(message: string, user: User): void
    + sendPrivateMessage(message: string, from: User, to: User): void
    + addUser(user: User): void
}

class ChatRoom {
    - users: vector<User*>
    + sendMessage(message: string, user: User): void
    + sendPrivateMessage(message: string, from: User, to: User): void
    + addUser(user: User): void
}

class User {
    - name: string
    - chatRoom: ChatRoomMediator*
    + send(message: string): void
    + sendPrivate(message: string, to: User): void
    + receive(message: string, from: User): void
    + receivePrivate(message: string, from: User): void
}

ChatRoomMediator <|.. ChatRoom
ChatRoom o-> User
User -> ChatRoomMediator : uses

note right of ChatRoom
    Routes messages between users
    Users don't communicate directly
end note

note right of User
    Sends all messages
    through chat room
end note
@enduml