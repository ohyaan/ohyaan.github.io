@startuml
!theme sunlust
actor Client
participant "context:\nConcreteClass" as Concrete
participant "base:\nAbstractClass" as Abstract

Client -> Concrete: templateMethod()
activate Concrete
Concrete -> Abstract: templateMethod()
activate Abstract

Abstract -> Abstract: Step 1 (common)

Abstract -> Concrete: primitiveOperation1()
activate Concrete
Concrete -> Concrete: specific implementation
Concrete --> Abstract: return
deactivate Concrete

Abstract -> Abstract: Step 2 (common)

Abstract -> Concrete: primitiveOperation2()
activate Concrete
Concrete -> Concrete: specific implementation
Concrete --> Abstract: return
deactivate Concrete

Abstract -> Concrete: hook()
activate Concrete
note right
    Optional override
    or use default
end note
Concrete --> Abstract: return
deactivate Concrete

Abstract --> Concrete: return
deactivate Abstract
Concrete --> Client: done
deactivate Concrete
@enduml