@startuml
!theme sunlust
class Originator {
    - state: State
    + save(): Memento
    + restore(m: Memento): void
}

class Memento {
    - state: State
    - timestamp: string
    + getState(): State
    + getTimestamp(): string
}

class Caretaker {
    - mementos: vector<Memento>
    - originator: Originator
    + backup(): void
    + undo(): void
    + showHistory(): void
}

Originator ..> Memento : creates
Caretaker o-> Memento : stores
Caretaker -> Originator : uses

note right of Originator
    Creates memento with
    its current state
    Restores state from
    memento
end note

note right of Memento
    Immutable snapshot
    Only originator can
    access state
end note

note right of Caretaker
    Manages mementos
    Doesn't examine
    memento contents
end note
@enduml