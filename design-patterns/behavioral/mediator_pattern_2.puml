@startuml
!theme sunlust
interface AirTrafficControl {
    + requestLanding(aircraft: Aircraft): bool
    + requestTakeoff(aircraft: Aircraft): bool
    + notifyRunwayClear(aircraft: Aircraft): void
    + registerAircraft(aircraft: Aircraft): void
}

class AirportTower {
    - aircrafts: vector<Aircraft*>
    - runwayAvailable: bool
    - landingQueue: vector<Aircraft*>
    - takeoffQueue: vector<Aircraft*>
    + requestLanding(aircraft: Aircraft): bool
    + requestTakeoff(aircraft: Aircraft): bool
    + notifyRunwayClear(aircraft: Aircraft): void
    + registerAircraft(aircraft: Aircraft): void
}

class Aircraft {
    - flightNumber: string
    - atc: AirTrafficControl*
    - isOnRunway: bool
    + requestLanding(): void
    + requestTakeoff(): void
    + land(): void
    + takeoff(): void
    + clearRunway(): void
}

AirTrafficControl <|.. AirportTower
AirportTower o-> Aircraft
Aircraft -> AirTrafficControl : coordinates with

note right of AirportTower
    Coordinates aircraft movements
    Manages runway access
    Prevents collisions
    Maintains queues
end note

note right of Aircraft
    All movements coordinated
    through tower
    No direct aircraft-to-aircraft
    communication
end note
@enduml