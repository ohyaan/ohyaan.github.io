@startuml
!theme sunlust
class Book {
    - title: string
    - author: string
    - year: int
    + Book(title, author, year)
    + getTitle(): string
    + getAuthor(): string
    + getYear(): int
    + display(): void
}

interface Iterator<Book> {
    + current(): Book&
    + next(): void
    + hasNext(): bool
    + reset(): void
}

interface BookCollection {
    + createIterator(): Iterator<Book>
    + createReverseIterator(): Iterator<Book>
    + addBook(book: Book): void
    + size(): int
}

class Library {
    - books: vector<Book>
    + addBook(book: Book): void
    + size(): int
    + createIterator(): Iterator<Book>
    + createReverseIterator(): Iterator<Book>
}

class LibraryIterator {
    - library: Library*
    - currentIndex: size_t
    + current(): Book&
    + next(): void
    + hasNext(): bool
    + reset(): void
}

class ReverseLibraryIterator {
    - library: Library*
    - currentIndex: size_t
    + current(): Book&
    + next(): void
    + hasNext(): bool
    + reset(): void
}

BookCollection <|.. Library
Iterator <|.. LibraryIterator
Iterator <|.. ReverseLibraryIterator
LibraryIterator o-> Library
ReverseLibraryIterator o-> Library
Library o-> Book

note right of LibraryIterator
    Forward iteration:
    first to last
end note

note right of ReverseLibraryIterator
    Reverse iteration:
    last to first
end note
@enduml