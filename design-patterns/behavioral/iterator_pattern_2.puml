@startuml
!theme sunlust
class TreeNode<T> {
    + data: T
    + children: vector<TreeNode*>
    + addChild(child: TreeNode*): void
}

class Tree<T> {
    - root: TreeNode<T>*
    + createDepthFirstIterator(): Iterator<TreeNode<T>>
    + createBreadthFirstIterator(): Iterator<TreeNode<T>>
}

interface Iterator<TreeNode<T>> {
    + current(): TreeNode<T>&
    + next(): void
    + hasNext(): bool
}

class DepthFirstIterator<T> {
    - stack: vector<TreeNode<T>*>
    - current: TreeNode<T>*
    + current(): TreeNode<T>&
    + next(): void
    + hasNext(): bool
}

class BreadthFirstIterator<T> {
    - queue: vector<TreeNode<T>*>
    - currentIndex: size_t
    - current: TreeNode<T>*
    + current(): TreeNode<T>&
    + next(): void
    + hasNext(): bool
}

Tree o-> TreeNode
Iterator <|.. DepthFirstIterator
Iterator <|.. BreadthFirstIterator
DepthFirstIterator ..> TreeNode : uses
BreadthFirstIterator ..> TreeNode : uses

note right of DepthFirstIterator
    Pre-order traversal:
    Visit node before children
    Uses stack (LIFO)
end note

note right of BreadthFirstIterator
    Level-order traversal:
    Visit level by level
    Uses queue (FIFO)
end note
@enduml