@startuml
!theme sunlust
class TextEditor {
    - text: string
    + insert(text: string, position: int): void
    + delete(length: int, position: int): string
    + getText(): string
}

interface Command {
    + execute(): void
    + undo(): void
}

class InsertTextCommand {
    - editor: TextEditor
    - text: string
    - position: int
    + execute(): void
    + undo(): void
}

class DeleteTextCommand {
    - editor: TextEditor
    - length: int
    - position: int
    - deletedText: string
    + execute(): void
    + undo(): void
}

class CommandHistory {
    - history: vector<Command>
    - currentPosition: size_t
    + executeCommand(command: Command): void
    + undo(): void
    + redo(): void
}

Command <|.. InsertTextCommand
Command <|.. DeleteTextCommand
InsertTextCommand o-> TextEditor
DeleteTextCommand o-> TextEditor
CommandHistory o-> Command

note right of InsertTextCommand
    execute(): insert text at position
    undo(): delete the inserted text
end note

note right of DeleteTextCommand
    execute(): delete text and save it
    undo(): insert the deleted text back
end note
@enduml