@startuml
!theme sunlust
interface Iterator<T> {
    + current(): T&
    + next(): void
    + hasNext(): bool
    + reset(): void
}

interface Aggregate<T> {
    + createIterator(): Iterator<T>
}

class ConcreteIterator<T> {
    - currentPosition: int
    - aggregate: ConcreteAggregate<T>
    + current(): T&
    + next(): void
    + hasNext(): bool
    + reset(): void
}

class ConcreteAggregate<T> {
    - items: vector<T>
    + createIterator(): Iterator<T>
    + add(item: T): void
    + size(): int
    + operator[](index: int): T&
}

Iterator <|.. ConcreteIterator
Aggregate <|.. ConcreteAggregate
ConcreteIterator o-> ConcreteAggregate : aggregates

note right of Iterator
    Defines interface for
    accessing and traversing
    elements
end note

note right of ConcreteIterator
    Implements Iterator interface
    Keeps track of current position
end note

note right of Aggregate
    Defines interface for
    creating an Iterator object
end note
@enduml