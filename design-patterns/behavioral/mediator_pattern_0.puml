@startuml
!theme sunlust
interface Mediator {
    + notify(sender: Colleague, event: string): void
}

class ConcreteMediator {
    - colleague1: Colleague
    - colleague2: Colleague
    + notify(sender: Colleague, event: string): void
}

class Colleague {
    # mediator: Mediator
    + setMediator(mediator: Mediator): void
}

class ConcreteColleague1 {
    + operation1(): void
}

class ConcreteColleague2 {
    + operation2(): void
}

Mediator <|.. ConcreteMediator
Colleague <|-- ConcreteColleague1
Colleague <|-- ConcreteColleague2
Colleague o-> Mediator
ConcreteMediator o-> ConcreteColleague1
ConcreteMediator o-> ConcreteColleague2

note right of ConcreteMediator
    Implements cooperative
    behavior by coordinating
    Colleague objects
end note

note right of Colleague
    Communicates with other
    colleagues through mediator
end note
@enduml