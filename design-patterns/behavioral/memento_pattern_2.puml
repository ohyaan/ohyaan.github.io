@startuml
!theme sunlust
class Game {
    - level: int
    - score: int
    - health: int
    - position: Position
    + play(): void
    + takeDamage(amount: int): void
    + save(): GameStateMemento
    + restore(m: GameStateMemento): void
}

class GameStateMemento {
    - level: int
    - score: int
    - health: int
    - position: Position
    - timestamp: string
    + getLevel(): int
    + getScore(): int
    + getHealth(): int
    + getPosition(): Position
}

class GameSaveManager {
    - saves: vector<GameStateMemento>
    - game: Game
    + quickSave(): void
    + quickLoad(): void
    + loadSave(index: int): void
    + showSaves(): void
}

Game ..> GameStateMemento : creates
GameSaveManager o-> GameStateMemento : manages
GameSaveManager -> Game : saves/loads

note right of Game
    Complete game state
    including progress,
    player stats, and position
end note

note right of GameSaveManager
    Multiple save slots
    Quick save/load
    Save management
end note
@enduml