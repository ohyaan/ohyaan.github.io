@startuml
!theme sunlust
skinparam classAttributeIconSize 0

class Client {
    - context: Context[]
}

class Context {
    - extrinsicState: string
    - flyweight: Flyweight*
}

class Flyweight {
    - intrinsicState: string
    + operation(extrinsicState): void
}

class FlyweightFactory {
    - flyweights: map<string, Flyweight*>
    + getFlyweight(key): Flyweight*
}

Client --> Context
Client --> FlyweightFactory
Context --> Flyweight
FlyweightFactory --> Flyweight : creates/returns

note right of Flyweight
    Stores intrinsic state
    (shared by many objects)
end note

note left of Context
    Stores extrinsic state
    (unique per object)
end note

@enduml